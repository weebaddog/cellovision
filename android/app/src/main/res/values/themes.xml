<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0B0B10</color>
    <color name="accent">#8B6CFF</color>
    <color name="accent2">#3FB8FF</color>
    <style name="Theme.Cellovision" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Theme.Cellovision.Player" parent="Theme.Cellovision">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
