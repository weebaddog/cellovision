<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV's home-screen banner (320×180): the gradient with the play mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:width="320dp" android:height="180dp">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8B6CFF" android:endColor="#3FB8FF" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
